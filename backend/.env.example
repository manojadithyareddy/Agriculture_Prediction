# AgriPredict AI Backend Configuration
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Supabase Managed Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-key-for-admin-operations

# Roboflow Vision API Key
ROBOFLOW_API_KEY=your-roboflow-api-key

# HuggingFace (Optional)
HF_TOKEN=

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
